{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "w2talent",
	"observability": { "enabled": true },
	// IA (1.5.7): toda chamada passa pelo AI Gateway "w2talent" (não são segredos).
	// A chave mestra AI_KEYS_MASTER é um Worker Secret, criado no painel.
	"vars": {
		"AI_GATEWAY_ACCOUNT_ID": "8ec1a59d6df85f5a8702e3843cbf83ef",
		"AI_GATEWAY_ID": "w2talent",
		"AI_DAILY_BUDGET_USD": "1"
	},
	// Não apaga as variáveis criadas no painel quando o deploy publica as de cima.
	"keep_vars": true,
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "w2talent"
		}
	],
	// Banco: Hyperdrive na frente do Neon (São Paulo). O ID não é segredo; a senha fica só na Cloudflare.
	// localConnectionString = banco local do `next dev`/`wrangler dev` (w2talent-db, ver docs/INFRA_TEMPORARIA.md).
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "f30dd85213154074a6cc8d30dad79e44",
			"localConnectionString": "postgresql://w2talent:w2talent@localhost:5437/w2talent"
		}
	],
	"ai": {
		// Workers AI: toMarkdown lê os CVs (PDF/DOCX) — ver lib/doc-to-text.ts
		"binding": "AI"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Worker Previews (`wrangler preview`, usado nos PRs): só os bindings que o preview aceita.
	// O WORKER_SELF_REFERENCE (service binding) fica de fora — limitação dos previews.
	"previews": {
		"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f30dd85213154074a6cc8d30dad79e44" }],
		"ai": { "binding": "AI" },
		"images": { "binding": "IMAGES" },
		"vars": {
			"AI_GATEWAY_ACCOUNT_ID": "8ec1a59d6df85f5a8702e3843cbf83ef",
			"AI_GATEWAY_ID": "w2talent",
			"AI_DAILY_BUDGET_USD": "1"
		}
	}
}
