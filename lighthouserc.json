{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3999",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3999/",
        "http://localhost:3999/vagas",
        "http://localhost:3999/candidatos",
        "http://localhost:3999/minhas-candidaturas"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/relatorios"
    }
  }
}
