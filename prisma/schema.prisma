generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Sem binário Rust: roda no Cloudflare Worker via driver adapter (pg + Hyperdrive).
  engineType      = "client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Enums ──────────────────────────────────────────────────────────────
enum CandidateStatus {
  ativo
  arquivado
  purgado
}

enum VacancyStatus {
  ativa
  arquivada
}

enum ApplicationOrigin {
  candidaturaLote
  contatoLote
  swipe
}

enum ApplicationStatus {
  enviado
  visualizado
  respondido
  arquivado
}

/// 2.4 Painel RH (plano aprovado em 2026-11-18, D1): etapas que só o recrutador vê.
/// O candidato vê o status (enviado/visualizado/respondido/arquivado), derivado daqui (D3).
enum EtapaCandidatura {
  nova
  em_analise
  entrevista
  proposta
  contratada
  nao_seguiu
}

enum ValidationStatus {
  pendente
  validado
  rejeitado
}

enum PlanType {
  free
  pro
}

// ── CompanyProfile ───────────────────────────────────────────────────
model CompanyProfile {
  id               String           @id @default(cuid())
  nome             String
  cnpj             String?          @unique
  logoUrl          String?
  site             String?
  validacaoStatus  ValidationStatus @default(pendente)
  validacaoData    DateTime?
  vagasAtivasCount Int              @default(0)
  plano            PlanType         @default(free)
  /// Para onde vão as candidaturas (1.5.13). Sem ele, a candidatura só fica registrada.
  emailContato     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vacancies        Vacancy[]
  applications     Application[]
  membros          CompanyMember[]
}

// ── CompanyMember (2.1a) ─────────────────────────────────────────────
// Liga a conta do recrutador à empresa. Por enquanto uma empresa por conta (userId único);
// a empresa pode ter vários membros quando houver convite. Quem cadastra vira "dono".
model CompanyMember {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  papel     String         @default("dono")
  createdAt DateTime       @default(now())

  @@index([companyId])
}

// ── CandidateProfile ─────────────────────────────────────────────────
model CandidateProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  nome                String
  fotoUrl             String?
  titulo              String
  resumo3linhas       String?
  localidade          String?
  modo                String? // remoto | hibrido | presencial
  senioridade         String? // estagio | junior | pleno | senior | especialista | lideranca (1.5.10)
  regimePreferido     String[] @default([])
  pretensaoDe         Int?
  pretensaoAte        Int?
  pretensaoMoeda      String?  @default("BRL")
  /// [{ regime, valor, unidade: "mes"|"hora", moeda }]: o mínimo aceito em cada regime (2026-11-09).
  /// pretensaoDe/Ate/Moeda ficam com a primeira mensal, para quem ainda lê delas.
  pretensoes          Json     @default("[]")
  disponibilidade     String?
  mudanca             Boolean? // aceita mudar de cidade (1.5.10)
  objetivoCrescimento String?
  stack               Json     @default("[]") // [{skillId, nivel, anos}]
  experiencias        Json     @default("[]")
  formacao            Json     @default("[]")
  idiomas             Json     @default("[]")
  links               Json     @default("[]")

  // contato
  celular     String? // opcional desde o 1.5.10 (o e-mail é o contato principal)
  email       String
  whatsappOpt Boolean @default(false)
  telegramOpt Boolean @default(false)
  telefoneOpt String?

  // LGPD 4 consentimentos versionados
  tratamentoBuscaV Int  @default(1)
  contatoProxyV    Int  @default(1)
  nudgesV          Int  @default(1)
  iaReescritaV     Int  @default(1)
  consentTexts     Json @default("[]") // textos originais consentidos

  status         CandidateStatus @default(ativo)
  idiomaOriginal String          @default("pt-BR")

  // Ficha W2 (1.5.11): resumo padronizado pela IA, revisado pelo candidato. Ver lib/ficha.ts.
  fichaW2 Json?

  // higiene
  expiresAt   DateTime // now + 180d
  arquivadoEm DateTime? // quando a higiene arquivou; a exclusão definitiva conta 30 dias a partir daqui
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // busca (1.5.9: vetor do bge-m3; índices HNSW/GIN criados na migração, fora do Prisma)
  searchVector   Unsupported("tsvector")?
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddingHash  String?
  embeddedAt     DateTime?

  applications Application[]
  aprovacoes   ApplicationApproval[]
  sinais       FeedbackSignal[]
  traducoes    Traducao[]

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
  @@index([arquivadoEm])
}

// ── Vacancy ──────────────────────────────────────────────────────────
model Vacancy {
  id                String         @id @default(cuid())
  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titulo            String
  stack             Json           @default("[]") // [{skillId}]
  nivel             String?
  regime            String?
  localidade        String?
  faixaDe           Int?
  faixaAte          Int?
  faixaMoeda        String?        @default("BRL")
  descricaoBullets  Json           @default("[]")
  beneficios        Json           @default("[]")
  tipoContrato      String?
  expiresAt         DateTime
  renovacoes        Int            @default(0)
  views             Int            @default(0)
  candidaturasCount Int            @default(0)
  status            VacancyStatus  @default(ativa)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // busca (1.5.9: vetor do bge-m3; índices HNSW/GIN criados na migração, fora do Prisma)
  searchVector   Unsupported("tsvector")?
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddingHash  String?
  embeddedAt     DateTime?

  applications Application[]
  aprovacoes   ApplicationApproval[]
  sinais       FeedbackSignal[]
  traducoes    Traducao[]

  @@index([status])
  @@index([expiresAt])
  @@index([companyId])
}

// ── Application ──────────────────────────────────────────────────────
// vacancyId nullable: suporta "Contact" (contato direto sem vaga) conforme spec §5.4 (vacancyId?).
// ATENÇÃO Postgres: @@unique com nullable permite duplicatas (NULL != NULL). Correção:
// - Mantém @@unique para caso vacancyId NOT NULL (Postgres unique comporta non-null)
// - Migration SQL adicional cria partial unique index: CREATE UNIQUE INDEX ... WHERE vacancyId IS NOT NULL
//   Ver prisma/migrations/*_fix_application_unique/migration.sql
// - Aplicação deve dedupar em código: verificar existência antes de criar quando vacancyId != null
// Alternativa (se quiser normalizar): separar em modelos Application (vacancyId required) + Contact (sem vacancyId).
model Application {
  id                String            @id @default(cuid())
  vacancyId         String?
  vacancy           Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  candidateId       String
  candidate         CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId         String
  company           CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origem            ApplicationOrigin
  proxyThreadId     String            @unique
  status            ApplicationStatus @default(enviado)
  loteId            String?
  /// 1.5.13: e-mail para a empresa montado no envio e ainda fora da fila; o Cron diário tenta de novo
  /// com este mesmo conteúdo. null quando já entrou na fila (ou não há e-mail).
  emailPendente     Json?
  /// 2.4: etapa no Painel RH; etapaEm = última mudança; respondidaEm = primeira saída de "nova"
  /// (tempo até a primeira resposta); contatoLiberadoEm = quando foi para Entrevista (2.4c, D4).
  etapa             EtapaCandidatura  @default(nova)
  etapaEm           DateTime?
  respondidaEm      DateTime?
  contatoLiberadoEm DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  entrevistas       Entrevista[]

  @@unique([candidateId, vacancyId])
  @@index([candidateId])
  @@index([candidateId, createdAt])
  @@index([vacancyId])
  @@index([companyId])
  @@index([vacancyId, etapa])
  @@index([loteId])
}

// ── Entrevista (2.5a) ────────────────────────────────────────────────
// O recrutador oferece de 3 a 8 horários a uma candidatura em Entrevista (contato liberado, 2.4c);
// o candidato escolhe um pelo link do e-mail (/agendar?c=<código>; guardamos só o hash do código).
// Uma oferta nova da mesma candidatura cancela a anterior. Tudo em UTC; os fusos servem só para os e-mails.
// emailsPendentes: e-mails montados na transação e ainda fora da fila; o Cron diário tenta de novo.
enum StatusEntrevista {
  aberta
  marcada
  cancelada
}

model Entrevista {
  id               String           @id @default(cuid())
  applicationId    String
  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId        String
  /// User.id de quem ofereceu os horários (recebe as confirmações).
  recrutadorId     String
  duracaoMin       Int
  horarios         DateTime[]
  linkReuniao      String?
  tokenHash        String           @unique
  status           StatusEntrevista @default(aberta)
  inicio           DateTime?
  marcadaEm        DateTime?
  canceladaEm      DateTime?
  /// "candidato" | "recrutador"
  canceladaPor     String?
  /// SEQUENCE do convite (.ics): sobe a cada troca de horário ou cancelamento.
  sequencia        Int              @default(0)
  fusoRecrutador   String?
  idiomaRecrutador String?
  fusoCandidato    String?
  emailsPendentes  Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([applicationId, createdAt])
  @@index([recrutadorId, status, inicio])
  @@index([companyId])
}

// ── ApplicationApproval (1.5.13) ─────────────────────────────────────
// O candidato aprova cada vaga antes do envio. vacancyHash cobre o que a pessoa leu (título, empresa,
// regime, faixa, local, nível, competências, descrição e benefícios); se a vaga mudar, a aprovação cai.
// snapshot guarda esses campos para mostrar o que mudou. Ao enviar, a aprovação vira Application.
model ApplicationApproval {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId   String
  vacancy     Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  vacancyHash String
  snapshot    Json
  aprovadaEm  DateTime         @default(now())

  @@unique([candidateId, vacancyId])
  @@index([vacancyId])
}

// ── FeedbackSignal (2.8, antecipado pelo plano "IA para RH (SAP)", 2026-11-18) ──
// O que as pessoas fazem com as sugestões (aprovou, desfez, enviou, a vaga mudou), para o ranking
// adaptativo (3.1) e o "o que falta para as vagas" (B1). Sem texto livre nem contatos.
// Apagar o candidato apaga os sinais dele; apagar a vaga só tira a ligação.
model FeedbackSignal {
  id            String            @id @default(cuid())
  tipo          String
  ator          String
  candidateId   String?
  candidate     CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId     String?
  vacancy       Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  applicationId String?
  matchPct      Int?
  dados         Json?
  createdAt     DateTime          @default(now())

  @@index([tipo, createdAt])
  @@index([candidateId, createdAt])
  @@index([vacancyId])
}

// ── OtpCode ──────────────────────────────────────────────────────────
// ── ConsentLog ───────────────────────────────────────────────────────
model ConsentLog {
  id        String   @id @default(cuid())
  userId    String
  /// 1.5.5: ligado à conta (antes apontava para CandidateProfile.userId e não gravava).
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versao    Int
  tipo      String // tratamentoBusca | contatoProxy | nudges | iaReescrita
  texto     String   @db.Text
  baseLegal String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── HygieneEvent (idempotência nudges) ──────────────────────────────
model HygieneEvent {
  id        String   @id @default(cuid())
  userId    String
  marco     String // D150 | D165 | D175 | D180 | V_D12 | V_D14
  date      String // YYYY-MM-DD for dedupe per day
  createdAt DateTime @default(now())

  @@unique([userId, marco, date])
  @@index([userId])
}

// ── IA (1.5.7): fornecedores, modelos, rotas por tarefa e histórico ──
// Toda chamada de IA passa por lib/ai/router.ts e pelo Cloudflare AI Gateway.

enum AiProviderKind {
  WORKERS_AI
  OPENAI_COMPATIBLE
  ANTHROPIC
  GOOGLE
}

model AiProvider {
  id                  String         @id @default(cuid())
  nome                String         @unique
  tipo                AiProviderKind
  // Caminho do fornecedor dentro do AI Gateway (ex.: "openai", "anthropic", "google-ai-studio").
  // Vazio = chamada direta para baseUrl (fornecedor que o gateway não conhece).
  gatewayPath         String?
  baseUrl             String?
  // Chave de API cifrada com AES-GCM (lib/ai/keys.ts, chave mestra AI_KEYS_MASTER). Nunca em texto puro.
  chaveCifrada        String?        @db.Text
  chaveFinal          String? // 4 últimos caracteres, para o painel
  ativo               Boolean        @default(false)
  aceitaDadosPessoais Boolean        @default(false)
  notaPrivacidade     String?
  modelos             AiModel[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model AiModel {
  id                    String        @id @default(cuid())
  providerId            String
  provider              AiProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelo                String // id no fornecedor, ex.: "@cf/baai/bge-m3", "gpt-4o-mini"
  contexto              Int?
  precoEntradaUsdMilhao Float? // US$ por milhão de tokens de entrada
  precoSaidaUsdMilhao   Float?
  embeddingDim          Int?
  ativo                 Boolean       @default(true)
  createdAt             DateTime      @default(now())
  testes                AiModelTest[]

  @@unique([providerId, modelo])
}

// Resultado de cada teste de compatibilidade (1.5.8). Só o resultado: nunca texto de usuário.
model AiModelTest {
  id         String   @id @default(cuid())
  modelId    String
  model      AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  teste      String // ver lib/ai/compat.ts (texto, json, ferramentas, idiomas, contexto_longo, embeddings)
  ok         Boolean
  detalhe    String?
  latenciaMs Int?
  createdAt  DateTime @default(now())

  @@index([modelId, teste, createdAt])
}

// Tentativas erradas da senha de admin (1.5.8), por hash do IP. Some com o login do 1.5.5.
// Limite de uso por dia (1.5.10): leituras de CV e Fichas W2 por IP (só o hash), sem login.
model UsoDiario {
  chave String
  dia   String // YYYY-MM-DD (UTC)
  total Int    @default(0)

  @@id([chave, dia])
}

model AdminLoginLock {
  chave        String    @id // sha-256 do IP
  falhas       Int       @default(0)
  bloqueadoAte DateTime?
  updatedAt    DateTime  @updatedAt
}

model TaskRoute {
  tarefa             String   @id // ver lib/ai/tasks.ts
  modo               String   @default("automatico") // automatico | fixo
  // Modelos na ordem de preferência (ids de AiModel). No modo automático o mais barato vai primeiro.
  modelos            String[]
  orcamentoDiarioUsd Float?
  updatedAt          DateTime @updatedAt
}

// Histórico de chamadas. Nunca guarda o texto enviado nem o recebido (LGPD).
model AiInteraction {
  id            String   @id @default(cuid())
  tarefa        String
  fornecedor    String
  modelo        String
  ok            Boolean
  erro          String?
  tokensEntrada Int?
  tokensSaida   Int?
  custoUsd      Float    @default(0)
  latenciaMs    Int
  userId        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([tarefa, createdAt])
}

// ── Cache dos vetores de busca (1.5.9) ───────────────────────────────
// Vetor de cada texto buscado, por 7 dias. Guarda só o hash do texto, nunca o texto.
model QueryEmbedding {
  hash      String                      @id
  model     String
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())

  @@index([createdAt])
}

// ── Login (1.5.5): tabelas do Better Auth ───────────────────────────
// Nomes e campos são os que o Better Auth espera (adaptador Prisma). Ver lib/auth-server.ts.

model User {
  id               String         @id
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  twoFactorEnabled Boolean?       @default(false)
  /// "candidato" | "recrutador"; vazio até a pessoa escolher na primeira entrada (decisão 3).
  perfil           String?
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  consentLogs      ConsentLog[]
  empresa          CompanyMember?
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// true enquanto falta o código do autenticador nesta sessão (login social com autenticador ligado).
  mfaPendente Boolean? @default(false)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

// ── 2.6a Assistente de dúvidas (plano https://claude.ai/artifact/6rdLK68qJGL4gWHTXucY2G) ──
// Trechos dos artigos de ajuda (content/ajuda) com vetor bge-m3. O Worker refaz o índice de um
// idioma quando a versão (hash do texto dos artigos) muda; ver lib/ajuda-ia.ts.
model AjudaTrecho {
  id        String                       @id @default(cuid())
  idioma    String
  versao    String
  slug      String
  ordem     Int
  secao     String
  texto     String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  @@unique([idioma, slug, ordem])
  @@index([idioma, versao])
}

// Perguntas que a ajuda não soube responder, para ver o que falta nos artigos.
// Sem IP, sem conta, sem e-mail; contatos tirados do texto. Apagadas em 90 dias (Cron diário).
model PerguntaSemResposta {
  id            String   @id @default(cuid())
  idioma        String
  tela          String?
  texto         String
  motivo        String
  similaridade  Float?
  enviadaEquipe Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// 2.7 Tradução automática: cópia traduzida do texto escrito por pessoas (vaga; ficha no 2.7b).
/// Vale só enquanto hashOrigem bate com o texto atual; apaga junto com a vaga ou a ficha.
model Traducao {
  id           String            @id @default(cuid())
  vacancyId    String?
  vacancy      Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  candidateId  String?
  candidate    CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  idioma       String // pt-BR | en | es (destino)
  idiomaOrigem String // idioma em que o texto foi escrito, segundo a IA
  hashOrigem   String // sha-256 do texto original traduzido
  /// Campos traduzidos; null quando o texto já está no idioma de destino.
  conteudo     Json?
  modelo       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([vacancyId, idioma])
  @@unique([candidateId, idioma])
}

// 3.2 Inteligência de mercado: agregados anônimos calculados pelo Cron diário, uma foto por semana (12 semanas).
// Grupo vazio ("") = todos. p25/p50/p75 só são gravados quando o grupo passa no anonimato (n ≥ 10 e, para vagas, 3+ empresas).
model MarketStat {
  id          String   @id @default(cuid())
  semana      DateTime // segunda-feira 00:00 UTC da semana do cálculo
  metrica     String // faixa_de | faixa_ate | pretensao | demanda | oferta | resposta_horas
  skillId     String   @default("")
  nivel       String   @default("")
  regime      String   @default("")
  modo        String   @default("")
  moeda       String   @default("")
  n           Int
  nEmpresas   Int?
  nRecentes   Int? // demanda: vagas publicadas nos últimos 30 dias
  nAnteriores Int? // demanda: vagas publicadas 30 a 60 dias atrás
  p25         Float?
  p50         Float?
  p75         Float?
  createdAt   DateTime @default(now())

  @@unique([semana, metrica, skillId, nivel, regime, modo, moeda])
  @@index([metrica, skillId])
}

// 3.1 Ranking adaptativo: pesos das 5 partes do match aprendidos com as etapas que a empresa escolhe.
// escopo "global" (escopoId "") ou "empresa" (escopoId = companyId). Só vale com n ≥ 30; desligado = padrão.
model RankingWeights {
  id           String   @id @default(cuid())
  escopo       String
  escopoId     String   @default("")
  pesos        Json // { skills, nivel, condicoes, recencia, completude }, soma 100
  n            Int
  nPositivos   Int
  nNegativos   Int
  desligado    Boolean  @default(false)
  atualizadoEm DateTime @default(now())

  @@unique([escopo, escopoId])
}
