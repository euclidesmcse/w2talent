generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Sem binário Rust: roda no Cloudflare Worker via driver adapter (pg + Hyperdrive).
  engineType      = "client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Enums ──────────────────────────────────────────────────────────────
enum CandidateStatus {
  ativo
  arquivado
  purgado
}

enum VacancyStatus {
  ativa
  arquivada
}

enum ApplicationOrigin {
  candidaturaLote
  contatoLote
  swipe
}

enum ApplicationStatus {
  enviado
  visualizado
  respondido
  arquivado
}

enum ValidationStatus {
  pendente
  validado
  rejeitado
}

enum PlanType {
  free
  pro
}

// ── CompanyProfile ───────────────────────────────────────────────────
model CompanyProfile {
  id               String           @id @default(cuid())
  nome             String
  cnpj             String?          @unique
  logoUrl          String?
  site             String?
  validacaoStatus  ValidationStatus @default(pendente)
  validacaoData    DateTime?
  vagasAtivasCount Int              @default(0)
  plano            PlanType         @default(free)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vacancies        Vacancy[]
  applications     Application[]
}

// ── CandidateProfile ─────────────────────────────────────────────────
model CandidateProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  nome                String
  fotoUrl             String?
  titulo              String
  resumo3linhas       String?
  localidade          String?
  modo                String? // remoto | hibrido | presencial
  senioridade         String? // estagio | junior | pleno | senior | especialista | lideranca (1.5.10)
  regimePreferido     String[] @default([])
  pretensaoDe         Int?
  pretensaoAte        Int?
  pretensaoMoeda      String?  @default("BRL")
  disponibilidade     String?
  mudanca             Boolean? // aceita mudar de cidade (1.5.10)
  objetivoCrescimento String?
  stack               Json     @default("[]") // [{skillId, nivel, anos}]
  experiencias        Json     @default("[]")
  formacao            Json     @default("[]")
  idiomas             Json     @default("[]")
  links               Json     @default("[]")

  // contato
  celular     String? // opcional desde o 1.5.10 (o e-mail é o contato principal)
  email       String
  whatsappOpt Boolean @default(false)
  telegramOpt Boolean @default(false)
  telefoneOpt String?

  // LGPD 4 consentimentos versionados
  tratamentoBuscaV Int  @default(1)
  contatoProxyV    Int  @default(1)
  nudgesV          Int  @default(1)
  iaReescritaV     Int  @default(1)
  consentTexts     Json @default("[]") // textos originais consentidos

  status         CandidateStatus @default(ativo)
  idiomaOriginal String          @default("pt-BR")

  // Ficha W2 (1.5.11): resumo padronizado pela IA, revisado pelo candidato. Ver lib/ficha.ts.
  fichaW2 Json?

  // higiene
  expiresAt   DateTime // now + 180d
  arquivadoEm DateTime? // quando a higiene arquivou; a exclusão definitiva conta 30 dias a partir daqui
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // busca (1.5.9: vetor do bge-m3; índices HNSW/GIN criados na migração, fora do Prisma)
  searchVector   Unsupported("tsvector")?
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddingHash  String?
  embeddedAt     DateTime?

  consentLogs  ConsentLog[]
  applications Application[]

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
  @@index([arquivadoEm])
}

// ── Vacancy ──────────────────────────────────────────────────────────
model Vacancy {
  id                String         @id @default(cuid())
  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titulo            String
  stack             Json           @default("[]") // [{skillId}]
  nivel             String?
  regime            String?
  localidade        String?
  faixaDe           Int?
  faixaAte          Int?
  faixaMoeda        String?        @default("BRL")
  descricaoBullets  Json           @default("[]")
  beneficios        Json           @default("[]")
  tipoContrato      String?
  expiresAt         DateTime
  renovacoes        Int            @default(0)
  views             Int            @default(0)
  candidaturasCount Int            @default(0)
  status            VacancyStatus  @default(ativa)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // busca (1.5.9: vetor do bge-m3; índices HNSW/GIN criados na migração, fora do Prisma)
  searchVector   Unsupported("tsvector")?
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddingHash  String?
  embeddedAt     DateTime?

  applications Application[]

  @@index([status])
  @@index([expiresAt])
  @@index([companyId])
}

// ── Application ──────────────────────────────────────────────────────
// vacancyId nullable: suporta "Contact" (contato direto sem vaga) conforme spec §5.4 (vacancyId?).
// ATENÇÃO Postgres: @@unique com nullable permite duplicatas (NULL != NULL). Correção:
// - Mantém @@unique para caso vacancyId NOT NULL (Postgres unique comporta non-null)
// - Migration SQL adicional cria partial unique index: CREATE UNIQUE INDEX ... WHERE vacancyId IS NOT NULL
//   Ver prisma/migrations/*_fix_application_unique/migration.sql
// - Aplicação deve dedupar em código: verificar existência antes de criar quando vacancyId != null
// Alternativa (se quiser normalizar): separar em modelos Application (vacancyId required) + Contact (sem vacancyId).
model Application {
  id            String            @id @default(cuid())
  vacancyId     String?
  vacancy       Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  candidateId   String
  candidate     CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String
  company       CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origem        ApplicationOrigin
  proxyThreadId String            @unique
  status        ApplicationStatus @default(enviado)
  loteId        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([candidateId, vacancyId])
  @@index([candidateId])
  @@index([vacancyId])
  @@index([companyId])
  @@index([loteId])
}

// ── OtpCode ──────────────────────────────────────────────────────────
model OtpCode {
  id          String    @id @default(cuid())
  userId      String // celular E.164
  codigoHash  String
  codigo      String? // only for testing/debug, not in prod — kept hashed normally
  expiraEm    DateTime
  tentativas  Int       @default(0)
  bloqueioAte DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiraEm])
}

// ── ConsentLog ───────────────────────────────────────────────────────
model ConsentLog {
  id        String            @id @default(cuid())
  userId    String
  candidate CandidateProfile? @relation(fields: [userId], references: [userId], onDelete: Cascade)
  versao    Int
  tipo      String // tratamentoBusca | contatoProxy | nudges | iaReescrita
  texto     String            @db.Text
  baseLegal String
  createdAt DateTime          @default(now())

  @@index([userId])
}

// ── HygieneEvent (idempotência nudges) ──────────────────────────────
model HygieneEvent {
  id        String   @id @default(cuid())
  userId    String
  marco     String // D150 | D165 | D175 | D180 | V_D12 | V_D14
  date      String // YYYY-MM-DD for dedupe per day
  createdAt DateTime @default(now())

  @@unique([userId, marco, date])
  @@index([userId])
}

// ── IA (1.5.7): fornecedores, modelos, rotas por tarefa e histórico ──
// Toda chamada de IA passa por lib/ai/router.ts e pelo Cloudflare AI Gateway.

enum AiProviderKind {
  WORKERS_AI
  OPENAI_COMPATIBLE
  ANTHROPIC
  GOOGLE
}

model AiProvider {
  id                  String         @id @default(cuid())
  nome                String         @unique
  tipo                AiProviderKind
  // Caminho do fornecedor dentro do AI Gateway (ex.: "openai", "anthropic", "google-ai-studio").
  // Vazio = chamada direta para baseUrl (fornecedor que o gateway não conhece).
  gatewayPath         String?
  baseUrl             String?
  // Chave de API cifrada com AES-GCM (lib/ai/keys.ts, chave mestra AI_KEYS_MASTER). Nunca em texto puro.
  chaveCifrada        String?        @db.Text
  chaveFinal          String? // 4 últimos caracteres, para o painel
  ativo               Boolean        @default(false)
  aceitaDadosPessoais Boolean        @default(false)
  notaPrivacidade     String?
  modelos             AiModel[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model AiModel {
  id                    String        @id @default(cuid())
  providerId            String
  provider              AiProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelo                String // id no fornecedor, ex.: "@cf/baai/bge-m3", "gpt-4o-mini"
  contexto              Int?
  precoEntradaUsdMilhao Float? // US$ por milhão de tokens de entrada
  precoSaidaUsdMilhao   Float?
  embeddingDim          Int?
  ativo                 Boolean       @default(true)
  createdAt             DateTime      @default(now())
  testes                AiModelTest[]

  @@unique([providerId, modelo])
}

// Resultado de cada teste de compatibilidade (1.5.8). Só o resultado: nunca texto de usuário.
model AiModelTest {
  id         String   @id @default(cuid())
  modelId    String
  model      AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  teste      String // ver lib/ai/compat.ts (texto, json, ferramentas, idiomas, contexto_longo, embeddings)
  ok         Boolean
  detalhe    String?
  latenciaMs Int?
  createdAt  DateTime @default(now())

  @@index([modelId, teste, createdAt])
}

// Tentativas erradas da senha de admin (1.5.8), por hash do IP. Some com o login do 1.5.5.
// Limite de uso por dia (1.5.10): leituras de CV e Fichas W2 por IP (só o hash), sem login.
model UsoDiario {
  chave String
  dia   String // YYYY-MM-DD (UTC)
  total Int    @default(0)

  @@id([chave, dia])
}

model AdminLoginLock {
  chave        String    @id // sha-256 do IP
  falhas       Int       @default(0)
  bloqueadoAte DateTime?
  updatedAt    DateTime  @updatedAt
}

model TaskRoute {
  tarefa             String   @id // ver lib/ai/tasks.ts
  modo               String   @default("automatico") // automatico | fixo
  // Modelos na ordem de preferência (ids de AiModel). No modo automático o mais barato vai primeiro.
  modelos            String[]
  orcamentoDiarioUsd Float?
  updatedAt          DateTime @updatedAt
}

// Histórico de chamadas. Nunca guarda o texto enviado nem o recebido (LGPD).
model AiInteraction {
  id            String   @id @default(cuid())
  tarefa        String
  fornecedor    String
  modelo        String
  ok            Boolean
  erro          String?
  tokensEntrada Int?
  tokensSaida   Int?
  custoUsd      Float    @default(0)
  latenciaMs    Int
  userId        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([tarefa, createdAt])
}

// ── Cache dos vetores de busca (1.5.9) ───────────────────────────────
// Vetor de cada texto buscado, por 7 dias. Guarda só o hash do texto, nunca o texto.
model QueryEmbedding {
  hash      String                      @id
  model     String
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())

  @@index([createdAt])
}
